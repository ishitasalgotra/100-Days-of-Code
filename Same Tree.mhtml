<strong>Output:</strong> true
</pre>

<p><strong class=3D"example">Example 2:</strong></p>
<img alt=3D"" src=3D"https://assets.leetcode.com/uploads/2020/12/20/ex2.jpg=
" style=3D"width: 382px; height: 182px;">
<pre><strong>Input:</strong> p =3D [1,2], q =3D [1,null,2]
<strong>Output:</strong> false
</pre>

<p><strong class=3D"example">Example 3:</strong></p>
<img alt=3D"" src=3D"https://assets.leetcode.com/uploads/2020/12/20/ex3.jpg=
" style=3D"width: 622px; height: 182px;">
<pre><strong>Input:</strong> p =3D [1,2,1], q =3D [1,1,2]
<strong>Output:</strong> false
</pre>

<p>&nbsp;</p>
<p><strong>Constraints:</strong></p>

<ul>
